# Peer resolution: install missing peers, but do not fail the install on a
# mismatch (a few React 19 / Next 16 peers upstream are still declared for 18/15).
auto-install-peers=true
strict-peer-dependencies=false

# Vercel selects pnpm 9 for this project (by project creation date) rather than
# the pnpm 11 pinned in packageManager. Without this, that older pnpm refuses to
# run at all over the version mismatch; the lockfile is v9.0 so it reads fine.
package-manager-strict=false
